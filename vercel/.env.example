# Vercel → Settings → Environment Variables (or `vercel env add`). Never commit the real values.
# n8n's public address (Railway: https://<your service>.up.railway.app/). The dashboard reads the briefs from
# <N8N_BASE_URL>/webhook/market-brief (SM-04) and the daily check asks <N8N_BASE_URL>/healthz.
N8N_BASE_URL=https://your-n8n.up.railway.app/
# Same value as BRIEF_SECRET on the n8n side (credential "Market brief secret").
BRIEF_SECRET=
# Any long random text; Vercel sends it to the daily check (cron).
CRON_SECRET=
# Optional: where the "n8n is down" alert goes (same bot and chat as n8n).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: the full SM-04 webhook URL, only when it is not <N8N_BASE_URL>/webhook/market-brief.
# N8N_BRIEF_URL=
