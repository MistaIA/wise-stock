# Copy to .env (Docker) or paste into Railway → Variables. Never commit the real file.

# ---------- n8n ----------
# Encrypts the credentials stored in the database. Generate once (e.g. `openssl rand -hex 32`) and never change it.
N8N_ENCRYPTION_KEY=
# Public base URL of n8n. Telegram (WF-11.2 assistant) only accepts https.
#   local Docker: http://localhost:5678/      Railway: https://<your-service>.up.railway.app/
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/
# 1 when n8n runs behind a proxy (Railway, Render, Nginx), 0 for local Docker.
N8N_PROXY_HOPS=0
# Only for http access from another machine on your network (not needed for http://localhost).
# N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=Africa/Lagos
TZ=Africa/Lagos

# ---------- database (docker-compose.yml starts this Postgres) ----------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
POSTGRES_DB=n8n
# On Railway, set these instead (from the Postgres service): DB_TYPE=postgresdb, DB_POSTGRESDB_HOST,
# DB_POSTGRESDB_PORT, DB_POSTGRESDB_DATABASE, DB_POSTGRESDB_USER, DB_POSTGRESDB_PASSWORD.

# ---------- your keys (the setup turns them into n8n credentials on every start) ----------
# Empty = a REPLACE_ME credential is created once; then fill it in n8n → Credentials instead.
TELEGRAM_BOT_TOKEN=
# Your chat id (message @userinfobot), a channel/group id like -100123456789, or @yourchannel.
# The Telegram assistant (WF-11.2) answers only this chat; it needs the number, not @yourchannel.
TELEGRAM_CHAT_ID=
# AI, for the short AI paragraph of the briefs and for the Telegram assistant. One key is enough. Without any,
# the briefs still go out (without that paragraph) and the assistant waits.
# Google Gemini: free key at https://aistudio.google.com/apikey. With only this key set, the setup switches the
# workflows' AI nodes to Gemini.
GEMINI_API_KEY=
# Optional: another Gemini model, for example gemini-2.5-flash-lite (default: gemini-3.1-flash-lite).
# GEMINI_MODEL=
OPENAI_API_KEY=
# Optional, only when both keys are set: gemini or openai (default: openai).
# AI_PROVIDER=
# Free key at financialmodelingprep.com (250 calls/day).
FMP_API_KEY=
# Shared secret between the Vercel dashboard and n8n (same value as BRIEF_SECRET on Vercel).
BRIEF_SECRET=
# Optional: chart-img.com key for the WF-11.1 chart tool.
CHART_IMG_API_KEY=

# ---------- setup behaviour ----------
# Publish the workflows automatically once their keys are filled in (schedules start running).
N8N_AUTO_PUBLISH=true
# Set to true once to re-import the workflow files over your edited copies.
SM_REIMPORT_WORKFLOWS=false

# ---------- optional: separate task-runner container (docker-compose.runners.yml) ----------
# N8N_RUNNERS_AUTH_TOKEN=
