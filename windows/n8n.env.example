# Copy this file to windows\n8n.env and fill it in. start-n8n.cmd loads it before every start.
# One KEY=VALUE per line, no quotes needed, "#" starts a comment line. Keep n8n.env private: it holds your keys.

# ---------- your keys (the setup turns them into n8n credentials on every start) ----------
TELEGRAM_BOT_TOKEN=
# Your chat id (message @userinfobot on Telegram), a group/channel id like -100123456789, or @yourchannel.
# The Telegram assistant (WF-11.2) answers only this chat; it needs the number, not @yourchannel.
TELEGRAM_CHAT_ID=
# AI, for the short AI paragraph of the briefs and for the Telegram assistant. One key is enough. Without any,
# the briefs still go out (without that paragraph) and the assistant waits.
# Google Gemini: free key at https://aistudio.google.com/apikey. With only this key set, the setup switches the
# workflows' AI nodes to Gemini.
GEMINI_API_KEY=
# Optional: another Gemini model, for example gemini-2.5-flash-lite (default: gemini-3.1-flash-lite).
# GEMINI_MODEL=
OPENAI_API_KEY=
# Optional, only when both keys are set: gemini or openai (default: openai).
# AI_PROVIDER=
# Free key at financialmodelingprep.com (250 calls a day).
FMP_API_KEY=
# Shared secret with the Vercel dashboard (the same value as BRIEF_SECRET on Vercel). Any long random text.
BRIEF_SECRET=
# Optional: chart-img.com key for the WF-11.1 chart tool.
CHART_IMG_API_KEY=

# ---------- setup ----------
# Publish the stock-market workflows as soon as their keys are in (their schedules then run while n8n runs).
# false = you publish and unpublish them in the editor yourself.
N8N_AUTO_PUBLISH=true
# true for one start = re-import the workflow files over the copies in n8n (your edits there are replaced).
SM_REIMPORT_WORKFLOWS=false

# ---------- n8n ----------
GENERIC_TIMEZONE=Africa/Lagos
# 127.0.0.1 = only this PC can open n8n. 0.0.0.0 = also other devices on your network
# (then add N8N_SECURE_COOKIE=false, because that access is plain http).
N8N_LISTEN_ADDRESS=127.0.0.1
N8N_PORT=5678
# Public https address of this n8n, only needed for the WF-11.2 Telegram assistant (for example a Cloudflare
# tunnel to this PC). Telegram accepts https only.
# N8N_WEBHOOK_URL=https://your-tunnel.example.com/
# Leave N8N_ENCRYPTION_KEY out: n8n creates its own key in <install folder>\.n8n\config on the first start.
# Setting one later makes n8n refuse to start ("Mismatching encryption keys").
